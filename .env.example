# Local development only. Docker database port is bound to loopback.
POSTGRES_USER=supportflow
POSTGRES_PASSWORD=supportflow_dev_only
POSTGRES_DB=supportflow
# Local-only application credential; production must use a secret manager.
SUPPORTFLOW_RUNTIME_DB_PASSWORD=supportflow_runtime_dev_only
# API/worker use a non-owner role. Alembic uses the separate migration connection below.
SUPPORTFLOW_DATABASE_URL=postgresql+psycopg://supportflow_runtime:supportflow_runtime_dev_only@127.0.0.1:15432/supportflow
SUPPORTFLOW_MIGRATION_DATABASE_URL=postgresql+psycopg://supportflow:supportflow_dev_only@127.0.0.1:15432/supportflow
SUPPORTFLOW_ENVIRONMENT=development
SUPPORTFLOW_LOG_LEVEL=INFO
# Explicit local HTTP setting. HTTPS/production must use true and HTTPS origins.
SUPPORTFLOW_COOKIE_SECURE=false
SUPPORTFLOW_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Uvicorn trusts forwarded client/protocol headers only from these proxy peers.
# Keep loopback for local access; set exact proxy IPs/CIDRs for a real deployment, never *.
SUPPORTFLOW_FORWARDED_ALLOW_IPS=127.0.0.1
# Disposable local-only key for encrypting email action links in the PostgreSQL outbox.
# Generate and store a unique secret before any non-local deployment.
SUPPORTFLOW_TOKEN_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
SUPPORTFLOW_PUBLIC_APP_URL=http://localhost:5173
SUPPORTFLOW_EMAIL_FROM=support@supportflow.local
# Bounded deterministic Incident Radar settings (lexical-v1).
SUPPORTFLOW_RADAR_LOOKBACK_HOURS=72
SUPPORTFLOW_RADAR_PAIR_WINDOW_MINUTES=360
SUPPORTFLOW_RADAR_SIMILARITY_THRESHOLD=0.30
SUPPORTFLOW_RADAR_MIN_SHARED_TERMS=2
SUPPORTFLOW_RADAR_MAX_TICKETS=500
SUPPORTFLOW_RADAR_MAX_CANDIDATE_PAIRS=50000
# M8 local FastEmbed cache (host tools only; Compose worker uses its named volume).
# Model weights are downloaded explicitly and must not be committed.
SUPPORTFLOW_SEMANTIC_MODEL_CACHE_DIR=./.cache/supportflow/models
SUPPORTFLOW_SEMANTIC_INDEX_BATCH_SIZE=50
SUPPORTFLOW_SEMANTIC_INDEX_MAX_ATTEMPTS=5
SUPPORTFLOW_SEMANTIC_MIN_SIMILARITY=0.35
# Bounded daily cleanup; ticket content, audit and SLA history are retained.
SUPPORTFLOW_RETENTION_BATCH_SIZE=500
SUPPORTFLOW_SESSION_RETENTION_DAYS=30
SUPPORTFLOW_TOKEN_RETENTION_DAYS=30
SUPPORTFLOW_INVITATION_RETENTION_DAYS=90
SUPPORTFLOW_WEBHOOK_RECEIPT_RETENTION_DAYS=365
SUPPORTFLOW_NOTIFICATION_RETENTION_DAYS=180
SUPPORTFLOW_COMPLETED_JOB_RETENTION_DAYS=30
SUPPORTFLOW_RADAR_RUN_RETENTION_DAYS=90
SUPPORTFLOW_STALE_EMBEDDING_RETENTION_DAYS=30
